<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ekspedisi.controller.ResiController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Aplikasi CRUD Resi Ekspedisi" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nama Penerima:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNama" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Berat (Kg):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtBerat" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Layanan:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cmbLayanan" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Tambah" onAction="#handleTambah"/>
        <Button text="Update" onAction="#handleUpdate"/>
        <Button text="Hapus" onAction="#handleDelete"/>
        <Button text="Clear" onAction="#handleClear"/>
    </HBox>

    <TableView fx:id="tblResi" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID Resi" prefWidth="80"/>
            <TableColumn fx:id="colNama" text="Penerima" prefWidth="150"/>
            <TableColumn fx:id="colBerat" text="Berat (Kg)" prefWidth="80"/>
            <TableColumn fx:id="colLayanan" text="Layanan" prefWidth="100"/>
            <TableColumn fx:id="colOngkir" text="Total Ongkir" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>