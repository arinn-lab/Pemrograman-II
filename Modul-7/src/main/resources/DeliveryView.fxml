<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.35" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="deliveryapp.DeliveryController">
    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0"
                style="-fx-background-color: #f4f4f4;">
        <VBox alignment="TOP_CENTER" layoutX="14.0" layoutY="14.0" spacing="20.0" AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="New Shipment" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <GridPane vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="90.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="196.0" minWidth="10.0" prefWidth="196.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                </rowConstraints>
                <Label text="Receipt No:"/>
                <TextField fx:id="txtReceiptNo" promptText="e.g. RES-001" GridPane.columnIndex="1"/>
                <Label text="Sender Name:" GridPane.rowIndex="1"/>
                <TextField fx:id="txtSender" promptText="Enter Sender Name" GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>
                <Label text="Destination:" GridPane.rowIndex="2"/>
                <TextField fx:id="txtDestination" promptText="Enter City" GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>
                <Label text="Weight (Kg):" GridPane.rowIndex="3"/>
                <TextField fx:id="txtWeight" promptText="0.0" GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>
                <Label text="Service Type:" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cmbServiceType" prefWidth="200.0" GridPane.columnIndex="1"
                          GridPane.rowIndex="4"/>
            </GridPane>
            <VBox spacing="10.0">
                <padding>
                    <Insets top="20.0"/>
                </padding>
                <Button mnemonicParsing="false" onAction="#handleAdd" prefWidth="Infinity"
                        style="-fx-background-color: #27ae60;" text="Add Package" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Button>
                <HBox spacing="10.0">
                    <Button mnemonicParsing="false" onAction="#handleUpdate" prefWidth="1000.0"
                            style="-fx-background-color: #f39c12;" text="Update" textFill="WHITE"/>
                    <Button mnemonicParsing="false" onAction="#handleDelete" prefWidth="1000.0"
                            style="-fx-background-color: #c0392b;" text="Delete" textFill="WHITE"/>
                </HBox>
                <Button mnemonicParsing="false" onAction="#handleClear" prefWidth="Infinity"
                        text="Clear Form"/>
            </VBox>
        </VBox>
    </AnchorPane>

    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
        <VBox layoutX="14.0" layoutY="14.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Label text="Shipment List" textFill="#7f8c8d">
                <font>
                    <Font size="18.0"/>
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" left="10.0" top="10.0"/>
                </VBox.margin>
            </Label>
            <TableView fx:id="tablePackages" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colReceipt" prefWidth="85.0" text="Receipt"/>
                    <TableColumn fx:id="colSender" prefWidth="100.0" text="Sender"/>
                    <TableColumn fx:id="colDest" prefWidth="90.0" text="Destination"/>
                    <TableColumn fx:id="colWeight" prefWidth="60.0" text="Kg"/>
                    <TableColumn fx:id="colService" prefWidth="120.0" text="Service"/>
                    <TableColumn fx:id="colCost" prefWidth="100.0" text="Total Cost (Rp)"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </AnchorPane>
</SplitPane>